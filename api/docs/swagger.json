{
    "swagger": "2.0",
    "info": {
        "description": "REST API for the Ubuntu GPU VM lifecycle on CB-Tumblebug.",
        "title": "GPU VM API",
        "contact": {},
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "0.1.0"
    },
    "basePath": "/gpuvm",
    "paths": {
        "/ns/{nsId}/infra": {
            "get": {
                "description": "List every Infra of the namespace with its node status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Infra] GPU VM Lifecycle"
                ],
                "summary": "List GPU Infras",
                "operationId": "GetAllInfra",
                "parameters": [
                    {
                        "type": "string",
                        "default": "default",
                        "description": "Namespace ID",
                        "name": "nsId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Infra list",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/tumblebug.InfraInfo"
                            }
                        }
                    },
                    "500": {
                        "description": "Infra lookup failed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            },
            "post": {
                "description": "Provision an Ubuntu GPU VM from the configured template. The request is validated first and blocks until provisioning finishes, which takes several minutes",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Infra] GPU VM Lifecycle"
                ],
                "summary": "Create a GPU Infra",
                "operationId": "PostInfra",
                "parameters": [
                    {
                        "type": "string",
                        "default": "default",
                        "description": "Namespace ID",
                        "name": "nsId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Infra creation request",
                        "name": "infraReq",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.CreateInfraReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Infra created",
                        "schema": {
                            "$ref": "#/definitions/tumblebug.InfraInfo"
                        }
                    },
                    "400": {
                        "description": "Malformed request body",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Infra creation failed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/ns/{nsId}/infra/{infraId}": {
            "get": {
                "description": "Read one Infra with its nodes",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Infra] GPU VM Lifecycle"
                ],
                "summary": "Get a GPU Infra",
                "operationId": "GetInfra",
                "parameters": [
                    {
                        "type": "string",
                        "default": "default",
                        "description": "Namespace ID",
                        "name": "nsId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Infra ID",
                        "name": "infraId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Infra information",
                        "schema": {
                            "$ref": "#/definitions/tumblebug.InfraInfo"
                        }
                    },
                    "404": {
                        "description": "Infra not found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Infra lookup failed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            },
            "delete": {
                "description": "Terminate every node of the Infra and remove its records. Shared resources are kept; release them separately once the namespace holds no Infra",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Infra] GPU VM Lifecycle"
                ],
                "summary": "Delete a GPU Infra",
                "operationId": "DeleteInfra",
                "parameters": [
                    {
                        "type": "string",
                        "default": "default",
                        "description": "Namespace ID",
                        "name": "nsId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Infra ID",
                        "name": "infraId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Infra deleted",
                        "schema": {
                            "$ref": "#/definitions/model.DeleteInfraResp"
                        }
                    },
                    "404": {
                        "description": "Infra not found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Infra deletion failed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/ns/{nsId}/infra/{infraId}/access": {
            "get": {
                "description": "Report public IP, SSH port and login user per node. The SSH private key is returned only when showSshKey is true",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Infra] GPU VM Lifecycle"
                ],
                "summary": "Get access information of a GPU Infra",
                "operationId": "GetInfraAccess",
                "parameters": [
                    {
                        "type": "string",
                        "default": "default",
                        "description": "Namespace ID",
                        "name": "nsId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Infra ID",
                        "name": "infraId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "default": false,
                        "description": "Include the SSH private key",
                        "name": "showSshKey",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Access information",
                        "schema": {
                            "$ref": "#/definitions/tumblebug.InfraAccessInfo"
                        }
                    },
                    "404": {
                        "description": "Infra not found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Access information lookup failed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/ns/{nsId}/infra/{infraId}/control": {
            "post": {
                "description": "Apply suspend, resume, reboot or terminate to every node. Terminate stops the nodes but keeps the records, so delete the Infra afterwards to stop billing",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Infra] GPU VM Lifecycle"
                ],
                "summary": "Control a GPU Infra",
                "operationId": "PostInfraControl",
                "parameters": [
                    {
                        "type": "string",
                        "default": "default",
                        "description": "Namespace ID",
                        "name": "nsId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Infra ID",
                        "name": "infraId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Lifecycle action",
                        "name": "controlReq",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.ControlInfraReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Action applied",
                        "schema": {
                            "$ref": "#/definitions/model.ControlInfraResp"
                        }
                    },
                    "400": {
                        "description": "Unsupported action",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "404": {
                        "description": "Infra not found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Infra control failed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/ns/{nsId}/infra/{infraId}/gpu": {
            "get": {
                "description": "Run nvidia-smi on every node and return the reported GPU model, memory and driver version",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Infra] GPU VM Lifecycle"
                ],
                "summary": "Report GPUs of an Infra",
                "operationId": "GetInfraGPU",
                "parameters": [
                    {
                        "type": "string",
                        "default": "default",
                        "description": "Namespace ID",
                        "name": "nsId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Infra ID",
                        "name": "infraId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "GPU report per node",
                        "schema": {
                            "$ref": "#/definitions/tumblebug.CommandResults"
                        }
                    },
                    "404": {
                        "description": "Infra not found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "GPU report failed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/ns/{nsId}/infra/{infraId}/status": {
            "get": {
                "description": "Report the node status summary, suitable for polling while an Infra is being created",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Infra] GPU VM Lifecycle"
                ],
                "summary": "Get the status of a GPU Infra",
                "operationId": "GetInfraStatus",
                "parameters": [
                    {
                        "type": "string",
                        "default": "default",
                        "description": "Namespace ID",
                        "name": "nsId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Infra ID",
                        "name": "infraId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Infra status",
                        "schema": {
                            "$ref": "#/definitions/tumblebug.InfraStatusView"
                        }
                    },
                    "404": {
                        "description": "Infra not found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Infra status lookup failed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/ns/{nsId}/shared-resources": {
            "delete": {
                "description": "Delete the shared vNet, security group and SSH key of the namespace. Delete every Infra first: CB-Tumblebug does not cascade and the CSP rejects dependent resources",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Infra] GPU VM Lifecycle"
                ],
                "summary": "Release shared resources",
                "operationId": "DeleteSharedResources",
                "parameters": [
                    {
                        "type": "string",
                        "default": "default",
                        "description": "Namespace ID",
                        "name": "nsId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Shared resources released",
                        "schema": {
                            "$ref": "#/definitions/model.ReleaseSharedResourcesResp"
                        }
                    },
                    "500": {
                        "description": "Shared resource release failed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Report whether the service finished initialization and can accept traffic",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Health] Service Health"
                ],
                "summary": "Check service readiness",
                "operationId": "GetReadyz",
                "responses": {
                    "200": {
                        "description": "Service is ready",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service is still initializing",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.ControlInfraReq": {
            "type": "object",
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "description": "Action is one of suspend, resume, reboot, terminate.",
                    "type": "string",
                    "enum": [
                        "suspend",
                        "resume",
                        "reboot",
                        "terminate"
                    ],
                    "example": "suspend"
                }
            }
        },
        "model.ControlInfraResp": {
            "type": "object",
            "properties": {
                "affected": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "model.CreateInfraReq": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "description": "Name becomes the Infra ID; node names get a -N suffix.",
                    "type": "string",
                    "example": "gpu-lab"
                }
            }
        },
        "model.DeleteInfraResp": {
            "type": "object",
            "properties": {
                "deleted": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "model.ReleaseSharedResourcesResp": {
            "type": "object",
            "properties": {
                "released": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.ResourceResult"
                    }
                }
            }
        },
        "model.ResourceResult": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "model.SimpleMsg": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Infra not found"
                }
            }
        },
        "tumblebug.CommandResult": {
            "type": "object",
            "properties": {
                "command": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "err": {
                    "type": "string"
                },
                "nodeId": {
                    "type": "string"
                },
                "stderr": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "stdout": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        },
        "tumblebug.CommandResults": {
            "type": "object",
            "properties": {
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/tumblebug.CommandResult"
                    }
                }
            }
        },
        "tumblebug.InfraAccessInfo": {
            "type": "object",
            "properties": {
                "InfraId": {
                    "type": "string"
                },
                "InfraNodeGroupAccessInfo": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/tumblebug.NodeGroupAccessInfo"
                    }
                }
            }
        },
        "tumblebug.InfraInfo": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "node": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/tumblebug.NodeInfo"
                    }
                },
                "status": {
                    "type": "string"
                },
                "statusCount": {
                    "$ref": "#/definitions/tumblebug.StatusCountInfo"
                },
                "targetStatus": {
                    "type": "string"
                }
            }
        },
        "tumblebug.InfraStatusView": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "statusCount": {
                    "$ref": "#/definitions/tumblebug.StatusCountInfo"
                },
                "targetAction": {
                    "type": "string"
                },
                "targetStatus": {
                    "type": "string"
                }
            }
        },
        "tumblebug.NodeAccessInfo": {
            "type": "object",
            "properties": {
                "nodeId": {
                    "type": "string"
                },
                "nodeUserName": {
                    "type": "string"
                },
                "privateIP": {
                    "type": "string"
                },
                "privateKey": {
                    "type": "string"
                },
                "publicIP": {
                    "type": "string"
                },
                "sshPort": {
                    "type": "integer"
                }
            }
        },
        "tumblebug.NodeGroupAccessInfo": {
            "type": "object",
            "properties": {
                "BastionNodeId": {
                    "type": "string"
                },
                "NodeAccessInfo": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/tumblebug.NodeAccessInfo"
                    }
                },
                "NodeGroupId": {
                    "type": "string"
                }
            }
        },
        "tumblebug.NodeInfo": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "imageId": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "nodeGroupId": {
                    "type": "string"
                },
                "privateIP": {
                    "type": "string"
                },
                "publicIP": {
                    "type": "string"
                },
                "specId": {
                    "type": "string"
                },
                "sshPort": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "tumblebug.StatusCountInfo": {
            "type": "object",
            "properties": {
                "countCreating": {
                    "type": "integer"
                },
                "countRunning": {
                    "type": "integer"
                },
                "countTotal": {
                    "type": "integer"
                }
            }
        }
    }
}